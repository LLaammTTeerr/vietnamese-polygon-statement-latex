%%
%% olymp.sty — compatibility shim.
%%
%% This package was a Vietnamese fork of olymp.sty. It has been rewritten as
%% vnolymp; this file remains only so that documents saying
%% \usepackage{olymp} keep working.
%%
%% Options are forwarded verbatim, including the deprecated ones vnolymp
%% handles explicitly (`hidesetting`, `landscape`).
%%
%% New documents should say:
%%
%%     \usepackage[vietnamese, color, booklet]{vnolymp}
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{olymp}[2026/07/29 v0.1 compatibility shim for vnolymp]

\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{vnolymp}}
\ProcessOptions\relax

\RequirePackage{vnolymp}

\PackageWarningNoLine{olymp}{%
  This package is now a shim around vnolymp.\MessageBreak
  Replace \string\usepackage{olymp} with
  \string\usepackage{vnolymp}\MessageBreak
  when convenient%
}

\endinput
