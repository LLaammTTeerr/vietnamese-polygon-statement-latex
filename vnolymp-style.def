%%
%% vnolymp-style.def — fonts, colour, geometry, and every visual component.
%%
%% This module owns PRESENTATION only. It contains no logic and no prose: it
%% replaces the \vnolymp@render... hooks that vnolymp-problem.def and
%% vnolymp-example.def declare with \providecommand, and reads all wording
%% through \vnolymp@kw.
%%
%% Requires LuaLaTeX.
%%
\ProvidesFile{vnolymp-style.def}[2026/07/29 Visual design for vnolymp]

\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage{xcolor}
% \rowcolor lives in colortbl, which xcolor loads only under its `table`
% option. Required explicitly so the subtask table's tinted header row does
% not depend on some other package having requested it first.
\RequirePackage{colortbl}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{microtype}
\RequirePackage[
  a4paper,
  top        = 24mm,
  bottom     = 22mm,
  left       = 16mm,
  right      = 16mm,
  headheight = 15pt,
  headsep    = 7mm,
  footskip   = 12mm,
]{geometry}

%% ---------------------------------------------------------------------------
%% Fonts
%%
%% Latin Modern for body, maths and monospace; Source Sans Bold for headings
%% and chrome.
%%
%% Latin Modern is what pdfLaTeX — and therefore Polygon — gives you, so
%% formulas look the way a competitive programmer expects. The sans headings
%% are a deliberate mix: they carry the document's weight, which is why the
%% body can stay at regular.
%%
%% Every face here covers the complete Vietnamese precomposed set with zero
%% missing glyphs, verified by compiling all 134 characters and inspecting the
%% log. XCharter, a strong candidate on other grounds, is missing the entire
%% hook-above (dấu hỏi) tone class and renders it as tofu; DejaVu Sans Mono is
%% missing 46 characters. See spec §3.1 and tests/cases/selftest-missing-glyph.
%% ---------------------------------------------------------------------------

%% Regular, not Demi. Demi was tried to give the page more ink, but it made
%% body text heavier than Latin Modern Math, so every formula read visibly
%% lighter than the Vietnamese around it. Weight now comes from the headings.
\setmainfont{lmroman10-regular.otf}[
  BoldFont       = lmroman10-bold.otf,
  ItalicFont     = lmroman10-italic.otf,
  BoldItalicFont = lmroman10-bolditalic.otf,
  Ligatures      = TeX,
]

%% Headings are Source Sans, which ships under TWO different names depending on
%% the age of the installation:
%%
%%   SourceSans3-*    current TeX Live, package `sourcesans`
%%   SourceSansPro-*  older TeX Live and Debian's texlive-fonts-extra,
%%                    package `sourcesanspro`
%%
%% Adobe renamed the family, and TeX Live followed. Asking only for the Pro
%% names built fine on Debian and failed in the texlive/texlive image with
%% "The font SourceSansPro-Regular cannot be found; this may be but usually is
%% not a fontspec bug" — a message that names neither the real cause nor the
%% fix. Both names are accepted, newest first, and the weights are identical
%% between them.
\IfFontExistsTF{SourceSans3-Regular.otf}{%
  \setsansfont{SourceSans3-Regular.otf}[
    BoldFont       = SourceSans3-Semibold.otf,
    ItalicFont     = SourceSans3-RegularIt.otf,
    BoldItalicFont = SourceSans3-SemiboldIt.otf,
    Ligatures      = TeX,
  ]%
  \newfontfamily\vnolymp@ui{SourceSans3-Semibold.otf}[Ligatures = TeX]%
  \newfontfamily\vnolymp@uib{SourceSans3-Bold.otf}[Ligatures = TeX]%
}{%
  \IfFontExistsTF{SourceSansPro-Regular.otf}{%
    \setsansfont{SourceSansPro-Regular.otf}[
      BoldFont       = SourceSansPro-Semibold.otf,
      ItalicFont     = SourceSansPro-RegularIt.otf,
      BoldItalicFont = SourceSansPro-SemiboldIt.otf,
      Ligatures      = TeX,
    ]%
    \newfontfamily\vnolymp@ui{SourceSansPro-Semibold.otf}[Ligatures = TeX]%
    \newfontfamily\vnolymp@uib{SourceSansPro-Bold.otf}[Ligatures = TeX]%
  }{%
    \PackageError{vnolymp}{Source Sans is not installed}{%
      vnolymp sets every heading in Source Sans, and neither
      SourceSans3-Regular.otf\MessageBreak nor SourceSansPro-Regular.otf
      could be found.\MessageBreak
      \MessageBreak
      Install it with:  tlmgr install sourcesans\MessageBreak
      or, on Debian/Ubuntu:  apt install texlive-fonts-extra%
    }%
  }%
}

%% Ligatures=TeX is deliberately ABSENT here, and fontspec applies none by
%% default.
%%
%% Monospace exists to show literal characters. With TeX ligatures a backtick
%% silently becomes a curly quote, so the font could never display one — which
%% fails the moment a statement quotes shell syntax, a C string literal, or
%% Markdown. Prose-level quoting belongs in the surrounding serif, which does
%% have them enabled, so `like this' still yields curly quotes in body text.
\setmonofont{lmmono10-regular.otf}[
  BoldFont   = lmmonolt10-bold.otf,
  ItalicFont = lmmono10-italic.otf,
  Scale      = MatchLowercase,
]

%% \vnolymp@ui and \vnolymp@uib are defined by the family branch above, so that
%% they follow whichever naming the installation actually has.

%% Mathematics — Latin Modern Math, the companion to the body face.
%%
%% An earlier draft paired Source Serif with STIX Two and overrode the latin
%% and digit ranges to keep variables in the body font. Moving the body to
%% Latin Modern makes all of that unnecessary: text and maths are one family
%% again, so $n$ and $10^5$ match their surroundings with no range surgery.
\setmathfont{latinmodern-math.otf}

%% ---------------------------------------------------------------------------
%% Colour
%%
%% One accent, and a print mode that replaces it with greys.
%%
%% #0F4C81 converts to 66/255 in greyscale and carries white text at 8.9:1,
%% comfortably past WCAG AA, so a photocopied booklet stays legible. Print mode
%% exists anyway, for when the copier is worse than expected: it uses 70% black
%% with white text, mirroring the colour bar rather than inverting to dark text
%% on a light fill.
%% ---------------------------------------------------------------------------

\definecolor{vnolympAccent}{HTML}{0F4C81}
\definecolor{vnolympInk}{HTML}{1A1A1A}

\ifvnolymp@color
  \colorlet{vnolymp@head@bg}{vnolympAccent}
  \colorlet{vnolymp@head@fg}{white}
  \colorlet{vnolymp@panel@bg}{vnolympAccent!6}
  \colorlet{vnolymp@panel@rule}{vnolympAccent!30}
  \colorlet{vnolymp@panel@label}{vnolympAccent}
  \colorlet{vnolymp@mark}{vnolympAccent}
  \colorlet{vnolymp@sample@bg}{vnolympAccent!5}
  \colorlet{vnolymp@sample@rule}{vnolympAccent!25}
  \colorlet{vnolymp@table@head}{vnolympAccent!12}
  \colorlet{vnolymp@hdr@in}{vnolympAccent!22}
  \colorlet{vnolymp@hdr@out}{vnolympAccent!10}
  \colorlet{vnolymp@zebra}{vnolympAccent!5}
\else
  \colorlet{vnolymp@head@bg}{black!70}
  \colorlet{vnolymp@head@fg}{white}
  \colorlet{vnolymp@panel@bg}{black!4}
  \colorlet{vnolymp@panel@rule}{black!25}
  \colorlet{vnolymp@panel@label}{black!55}
  \colorlet{vnolymp@mark}{black!60}
  \colorlet{vnolymp@sample@bg}{black!4}
  \colorlet{vnolymp@sample@rule}{black!25}
  \colorlet{vnolymp@table@head}{black!10}
  \colorlet{vnolymp@hdr@in}{black!18}
  \colorlet{vnolymp@hdr@out}{black!8}
  \colorlet{vnolymp@zebra}{black!4}
\fi

\color{vnolympInk}

%% ---------------------------------------------------------------------------
%% Paragraphs
%%
%% Blocks separated by space rather than indented. A statement is a sequence of
%% short, self-contained paragraphs interleaved with headings and displays, and
%% first-line indentation reads as noise in that setting.
%% ---------------------------------------------------------------------------

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.42\baselineskip plus 0.12\baselineskip minus 0.08\baselineskip}

%% ---------------------------------------------------------------------------
%% Problem header
%% ---------------------------------------------------------------------------

\renewcommand{\vnolymp@renderheader}[3]{%
  \begin{tcolorbox}[
    colback      = vnolymp@head@bg,
    colframe     = vnolymp@head@bg,
    sharp corners,
    boxrule      = 0pt,
    left         = 3.5mm, right = 3.5mm,
    top          = 2mm,   bottom = 2mm,
    enlarge left by  = 0mm,
    width        = \linewidth,
  ]
    \color{vnolymp@head@fg}\vnolymp@uib\huge
    % "Bài N." only when the document holds more than one problem; see
    % \vnolymp@ifnumbered in vnolymp-problem.def.
    \vnolymp@ifnumbered{\vnolymp@kw{word.problem}~#1. }{}#2%
    \ifblank{#3}{}{\hfill #3~\vnolymp@kw{word.points}}%
  \end{tcolorbox}%
  \par
}

%% ---------------------------------------------------------------------------
%% Limits panel
%%
%% Label/value rows, one per supplied key. Labels in small sans, values in the
%% body face — including filenames, which were briefly set in monospace and
%% read as a foreign object beside the prose values sharing their column.
%% ---------------------------------------------------------------------------

\renewcommand{\vnolymp@renderpanel}[1]{%
  \begin{tcolorbox}[
    colback   = vnolymp@panel@bg,
    colframe  = vnolymp@panel@rule,
    sharp corners,
    boxrule   = 0.4pt,
    left      = 3.5mm, right = 3.5mm,
    top       = 2mm,   bottom = 2mm,
    width     = \linewidth,
  ]
    \setlength{\parskip}{0pt}%
    \begin{tabular}{@{}>{\vnolymp@ui\footnotesize\color{vnolymp@panel@label}}l@{\hspace{2em}}l@{}}
      #1
    \end{tabular}%
  \end{tcolorbox}%
  \par
}

%% ---------------------------------------------------------------------------
%% Section headings
%%
%% An accent bar rather than a rule or a number. Statements have few sections
%% and numbering them adds nothing a reader uses.
%% ---------------------------------------------------------------------------

\renewcommand{\vnolymp@sectionhead}[1]{%
  % More space above a heading than below it, so a section reads as
  % attached to its own body rather than floating between two.
  \par\addvspace{0.95\baselineskip}%
  \noindent
  {\color{vnolymp@mark}\rule[-1.1mm]{1.7mm}{6.0mm}}\hspace{1.5mm}%
  {\vnolymp@uib\LARGE #1}%
  \par\nopagebreak\addvspace{0.05\baselineskip}%
}

%% ---------------------------------------------------------------------------
%% Subtask table
%% ---------------------------------------------------------------------------

% tabularx, not tabular: the constraints column absorbs the slack so the table
% fills its frame exactly. With a fixed-width column the tinted header row
% stopped short of the box edge, leaving a visible ledge.
\renewcommand{\vnolymp@rendersubtasks}[1]{%
  \par\nopagebreak\noindent
  \begin{tcolorbox}[
    colback   = white,
    colframe  = vnolymp@panel@rule,
    sharp corners,
    boxrule   = 0.4pt,
    left      = 0mm, right = 0mm, top = 0mm, bottom = 0mm,
    width     = \linewidth,
  ]
    \setlength{\parskip}{0pt}%
    \renewcommand{\arraystretch}{1.35}%
    % Inter-column space comes from \tabcolsep, NOT from @{\hspace{...}}.
    % \rowcolor fills cells, and an @{} separator belongs to no cell, so it
    % stayed white -- the header tint broke into blocks with gaps between
    % the column names.
    \setlength{\tabcolsep}{3mm}%
    \begin{tabularx}{\linewidth}{c c X}
      \rowcolor{vnolymp@table@head}
      \vnolymp@uib\footnotesize\vnolymp@kw{table.subtask} &
      \vnolymp@uib\footnotesize\vnolymp@kw{table.points} &
      \vnolymp@uib\footnotesize\vnolymp@kw{table.constraints}\\
      #1
    \end{tabularx}%
  \end{tcolorbox}%
  \par
}

%% ---------------------------------------------------------------------------
%% Running head and foot
%%
%% Uses \kw{page.number} and \kw{page.of}, which the package this replaces
%% defined and then never referenced — it reserved 2cm of head height for a
%% header that did not exist.
%% ---------------------------------------------------------------------------

% Via the lastpage package rather than by hand. A plain
% \AtEndDocument{\clearpage\label{...}} does not work: by then there is no
% page left to attach the label to, so it never reaches the .aux and the
% reference stays undefined. lastpage writes the entry directly.
%
% The package this replaces inlined its own copy of that trick, while the
% document preamble separately loaded zref[totpages] for the same purpose.
\RequirePackage{lastpage}
\newcommand{\vnolymp@lastpage}{\pageref{LastPage}}

\fancypagestyle{vnolymp}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\headrule}{%
    {\color{vnolymp@mark}\hrule height 0.4pt width \headwidth}%
  }%
  \fancyhead[L]{\vnolymp@ui\footnotesize\color{black!60}\vnolymp@contest@name}%
  \fancyhead[R]{\vnolymp@ui\footnotesize\color{black!60}\vnolymp@contest@date}%
  \fancyfoot[C]{%
    \vnolymp@ui\footnotesize\color{black!60}
    \vnolymp@kw{page.number}~\thepage\ \vnolymp@kw{page.of}~\vnolymp@lastpage
  }%
}

\ifvnolymp@booklet
  \pagestyle{vnolymp}
\else
  \pagestyle{plain}
\fi

%% ---------------------------------------------------------------------------
%% Cover page
%%
%% Booklet mode only. \vnolympcover is explicit rather than automatic: a
%% document may want front matter before it, and silently emitting a page is
%% the kind of surprise that costs a reprint.
%% ---------------------------------------------------------------------------

\newcommand{\vnolympcover}{%
  \ifvnolymp@booklet
    \thispagestyle{empty}%
    \null\vspace*{0.18\textheight}%
    {\color{vnolymp@mark}\hrule height 1.2pt}%
    \vspace{4mm}
    {\vnolymp@ui\Huge\vnolymp@contest@name\par}
    \vspace{3mm}
    {\vnolymp@ui\Large\color{black!60}%
      \vnolymp@contest@place
      \ifdefempty{\vnolymp@contest@place}{}{%
        \ifdefempty{\vnolymp@contest@date}{}{\ \textperiodcentered\ }%
      }%
      \vnolymp@contest@date\par}
    \vspace{4mm}
    {\color{vnolymp@mark}\hrule height 0.4pt}%
    \vspace{14mm}
    \vnolymp@rendercovertable
    \vfill
    \clearpage
  \fi
}

% Empty on the first pass, since the rows come from the .aux file written by
% the previous one. Rendering nothing is correct rather than an error: the
% document simply needs its second pass, which every real build does.
\newcommand{\vnolymp@rendercovertable}{%
  \ifdefempty{\vnolymp@coverrows}{}{%
    \begingroup
    \setlength{\parskip}{0pt}%
    \renewcommand{\arraystretch}{1.4}%
    \noindent
    \begin{tabularx}{\linewidth}{@{}c@{\hspace{5mm}}X r r r@{}}
      \rowcolor{vnolymp@table@head}
      \vnolymp@ui\footnotesize\vnolymp@kw{word.problem} &
      \vnolymp@ui\footnotesize\vnolymp@kw{cover.name} &
      \vnolymp@ui\footnotesize\vnolymp@kw{cover.time} &
      \vnolymp@ui\footnotesize\vnolymp@kw{cover.memory} &
      \vnolymp@ui\footnotesize\vnolymp@kw{table.points}\\
      \vnolymp@coverrows
    \end{tabularx}%
    \endgroup
  }%
}

\endinput
